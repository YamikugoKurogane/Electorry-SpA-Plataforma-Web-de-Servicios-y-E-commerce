# =====================================================================
# CONFIGURACIÓN DE ENTORNO: STAGING
# =====================================================================
# Instrucciones: Copia este archivo a .env en el servidor de staging.
# NO subas el archivo .env real a GitHub.

# 1. SEGURIDAD Y DEBUG
DJANGO_DEBUG=0
# Genera una clave segura con: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
DJANGO_SECRET_KEY=reemplazar_por_clave_generada_en_el_servidor

# 2. DOMINIOS PERMITIDOS (HTTPS)
# Cambia esto por el dominio real o IP de tu servidor de staging
DJANGO_ALLOWED_HOSTS=staging.electorry.cl,tu-ip-publica
DJANGO_CSRF_TRUSTED_ORIGINS=https://staging.electorry.cl

# 3. BASE DE DATOS POSTGRESQL
# En Docker, el host suele ser el nombre del servicio (ej. 'db').
# Si usas un servicio de base de datos externo (RDS, Supabase, etc.), usa la URL que te den.
DATABASE_URL=postgres://electorry:clave_segura_staging@db:5432/electorry
POSTGRES_PASSWORD=clave_segura_staging

# 4. CORREO (SMTP REAL)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.tu-proveedor.cl
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=correo@electorry.cl
EMAIL_HOST_PASSWORD=password_del_correo
DEFAULT_FROM_EMAIL=Electorry SpA <no-reply@electorry.cl>
CORREO_AVISOS_INTERNOS=contacto@electorry.cl

# 5. PASARELA DE PAGO
PAYMENT_GATEWAY=sandbox
# WEBPAY_BASE_URL=https://webpay3gint.transbank.cl
# WEBPAY_COMMERCE_CODE=
# WEBPAY_API_SECRET=

# 6. DATOS DE LA EMPRESA
EMPRESA_EMAIL=contacto@electorry.cl
EMPRESA_TELEFONO=+56 9 1234 5678
EMPRESA_WHATSAPP=+56912345678